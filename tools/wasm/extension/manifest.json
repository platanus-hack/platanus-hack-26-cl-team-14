{
  "manifest_version": 3,
  "minimum_chrome_version": "142",
  "name": "Santiaguito",
  "version": "0.1.0",
  "description": "Control the Santiaguito simulator from the Chrome side panel.",
  "permissions": ["sidePanel"],
  "action": { "default_title": "Santiaguito" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [{
    "matches": [
      "https://santiaguito.cl/web/wasm/*",
      "http://localhost/web/wasm/*",
      "http://127.0.0.1/web/wasm/*"
    ],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
